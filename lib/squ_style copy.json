
{
  "version": 8,
  "name": "SQU Darb",
  "sources": {
    "squ": {
      "type": "vector",
      "tiles": [
        "https://example.invalid/{z}/{x}/{y}.pbf"
      ],
      "minzoom": 10,
      "maxzoom": 15
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#F2EFE9"
      }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "squ",
      "source-layer": "squ",
      "filter": ["has", "landuse"],
      "paint": {
        "fill-color": "#E0DFDF"
      }
    },
    {
      "id": "green-areas",
      "type": "fill",
      "source": "squ",
      "source-layer": "squ",
      "filter": ["has", "leisure"],
      "paint": {
        "fill-color": "#C8FACC"
      }
    },
    {
      "id": "natural-areas",
      "type": "fill",
      "source": "squ",
      "source-layer": "squ",
      "filter": ["has", "natural"],
      "paint": {
        "fill-color": "#CDEBB0"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "squ",
      "source-layer": "squ",
      "filter": ["has", "water"],
      "paint": {
        "fill-color": "#AAD3DF"
      }
    },
    {
      "id": "building-outlines",
      "type": "line",
      "source": "squ",
      "source-layer": "squ",
      "filter": ["has", "building"],
      "paint": {
        "line-color": "#C6B8A8",
        "line-width": 0.7
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "squ",
      "source-layer": "squ",
      "filter": ["has", "building"],
      "paint": {
        "fill-color": "#D9D0C5"
      }
    },
    {
      "id": "road-casings",
      "type": "line",
      "source": "squ",
      "source-layer": "squ",
      "filter": ["has", "highway"],
      "paint": {
        "line-color": "#D2CFC9",
        "line-width": 3.5
      }
    },
    {
      "id": "roads",
      "type": "line",
      "source": "squ",
      "source-layer": "squ",
      "filter": ["has", "highway"],
      "paint": {
        "line-color": "#FFFFFF",
        "line-width": 2
      }
    },
    {
      "id": "road-labels",
      "type": "symbol",
      "source": "squ",
      "source-layer": "squ",
      "filter": ["has", "name"],
      "layout": {
        "text-field": "{name}",
        "text-size": 10,
        "symbol-placement": "line"
      },
      "paint": {
        "text-color": "#666666",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "place-labels",
      "type": "symbol",
      "source": "squ",
      "source-layer": "squ",
      "filter": ["has", "name"],
      "layout": {
        "text-field": "{name}",
        "text-size": 12
      },
      "paint": {
        "text-color": "#333333",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 1.5
      }
    }
  ]
}
